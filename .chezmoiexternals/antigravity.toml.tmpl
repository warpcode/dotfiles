{{- if .is_default_linux }}

# ==============================================================================
# ANTIGRAVITY HUB (Native Tarball)
# ==============================================================================
{{- $hub_json := output "curl" "-fsSL" "https://antigravity-hub-auto-updater-974169037036.us-central1.run.app/releases" }}
{{- $hub_payload := fromJson $hub_json }}
{{- $hub := index $hub_payload 0 }}

[".local/opt/antigravity-hub"]
    type = "archive"
    url = {{ printf "https://storage.googleapis.com/antigravity-public/antigravity-hub/%s-%s/linux-x64/Antigravity.tar.gz" $hub.version $hub.execution_id | quote }}
    stripComponents = 1
    exact = true
    refreshPeriod = "24h"

{{- end }}
