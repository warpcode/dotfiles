{{- $canonical := includeTemplate "commands/canonical.tmpl" . | fromJson -}}
{{- $commands := $canonical.commands -}}
{{- $paths := $canonical.paths -}}

{{- $allow := list -}}
{{- range $c := $commands.allow -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $allow = append $allow (printf "command(%s)" $cmd) -}}
  {{- end -}}
{{- end -}}
{{- range $p := $paths.read -}}
  {{- $allow = append $allow (printf "read_file(%s)" $p) -}}
{{- end -}}
{{- range $p := $paths.write -}}
  {{- $allow = append $allow (printf "write_file(%s)" $p) -}}
{{- end -}}

{{- if and (hasKey . "chezmoi") (hasKey .chezmoi "homeDir") -}}
  {{- $cfgPath := joinPath .chezmoi.homeDir ".gemini/config/config.json" -}}
  {{- if stat $cfgPath -}}
    {{- $cfg := include $cfgPath | fromJson -}}
    {{- if and (hasKey $cfg "userSettings") (hasKey (index $cfg "userSettings") "globalPermissionGrants") -}}
      {{- $gpg := index (index $cfg "userSettings") "globalPermissionGrants" -}}
      {{- range $item := (get $gpg "allow" | default list) -}}
        {{- $norm := regexReplaceAll "^(read_file|write_file)\\((~)" $item (printf "${1}(%s" $.chezmoi.homeDir) -}}
        {{- $allow = append $allow $norm -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

{{- $ask := list -}}
{{- range $c := $commands.ask -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $ask = append $ask (printf "command(%s)" $cmd) -}}
  {{- end -}}
{{- end -}}

{{- $deny := list -}}
{{- range $c := $commands.deny -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $deny = append $deny (printf "command(%s)" $cmd) -}}
  {{- end -}}
{{- end -}}
{{- range $p := $paths.deny -}}
  {{- $deny = append $deny (printf "read_file(%s)" $p) -}}
  {{- $deny = append $deny (printf "write_file(%s)" $p) -}}
{{- end -}}

{{- $allow = $allow | uniq | sortAlpha -}}
{{- $ask = $ask | uniq | sortAlpha -}}
{{- $deny = $deny | uniq | sortAlpha -}}

"globalPermissionGrants": {{ dict "allow" $allow "ask" $ask "deny" $deny | toPrettyJson "  " | trim -}}
