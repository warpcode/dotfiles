{{- $canonical := includeTemplate "commands/canonical.tmpl" . | fromJson -}}
{{- $commands := $canonical.commands -}}
{{- $paths := $canonical.paths -}}

{{- $allow := list -}}
{{- range $c := $commands.allow -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $allow = append $allow (printf "command(%s)" $cmd) -}}
  {{- end -}}
{{- end -}}
{{- range $p := $paths.read -}}
  {{- $allow = append $allow (printf "read_file(%s)" $p) -}}
{{- end -}}
{{- range $p := $paths.write -}}
  {{- $allow = append $allow (printf "write_file(%s)" $p) -}}
{{- end -}}

{{- $ask := list -}}
{{- range $c := $commands.ask -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $ask = append $ask (printf "command(%s)" $cmd) -}}
  {{- end -}}
{{- end -}}

{{- $deny := list -}}
{{- range $c := $commands.deny -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $deny = append $deny (printf "command(%s)" $cmd) -}}
  {{- end -}}
{{- end -}}
{{- range $p := $paths.deny -}}
  {{- $deny = append $deny (printf "read_file(%s)" $p) -}}
  {{- $deny = append $deny (printf "write_file(%s)" $p) -}}
{{- end -}}

"globalPermissionGrants": {{ dict "allow" ($allow | uniq) "deny" ($deny | uniq) "ask" ($ask | uniq) | toPrettyJson "  " }}
