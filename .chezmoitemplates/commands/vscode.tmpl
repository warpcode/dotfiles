{{- $canonical := includeTemplate "commands/canonical.tmpl" . | fromJson -}}
{{- $commands := $canonical.commands -}}
{{- $paths := $canonical.paths | default dict -}}

{{- $termApprove := dict -}}

{{- range $c := $commands.allow -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $_ := set $termApprove $cmd true -}}
  {{- end -}}
{{- end -}}

{{- range $c := $commands.ask -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $_ := set $termApprove $cmd false -}}
  {{- end -}}
{{- end -}}

{{- range $c := $commands.deny -}}
  {{- $cmd := $c | trimSuffix "*" | trim -}}
  {{- if $cmd -}}
    {{- $_ := set $termApprove $cmd false -}}
  {{- end -}}
{{- end -}}

{{- $editsApprove := dict -}}
{{- range $p := ($paths.write | default list) -}}
  {{- $raw := trim $p -}}
  {{- if $raw }}{{ $_ := set $editsApprove $raw true }}{{ end -}}
{{- end -}}
{{- range $p := ($paths.deny | default list) -}}
  {{- $raw := trim $p -}}
  {{- if $raw }}{{ $_ := set $editsApprove $raw false }}{{ end -}}
{{- end -}}

"chat.tools.terminal.autoApprove": {{ $termApprove | toPrettyJson "  " }},
"chat.tools.edits.autoApprove": {{ $editsApprove | toPrettyJson "  " }}

