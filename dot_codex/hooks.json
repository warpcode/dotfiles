{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "df.ai-guard-hook prompt",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "df.ai-guard-hook",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "df.ai-guard-hook output",
        "timeout": 5
      }
    ]
  }
}
