{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "./ai-guard-wrapper.sh prompt",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "./ai-guard-wrapper.sh",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "./ai-guard-wrapper.sh output",
        "timeout": 5
      }
    ]
  }
}
