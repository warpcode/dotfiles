{{- $configPath := joinPath .chezmoi.homeDir ".gemini/config/config.json" -}}
{{- $userSettings := dict "remoteControlEnabled" true -}}
{{- if stat $configPath -}}
  {{- $existingConfig := include $configPath | fromJson -}}
  {{- if hasKey $existingConfig "userSettings" -}}
    {{- $userSettings = index $existingConfig "userSettings" -}}
  {{- else -}}
    {{- if hasKey $existingConfig "remoteControlEnabled" -}}
      {{- $_ := set $userSettings "remoteControlEnabled" (index $existingConfig "remoteControlEnabled") -}}
    {{- end -}}
    {{- if hasKey $existingConfig "remoteControlHostname" -}}
      {{- $_ := set $userSettings "remoteControlHostname" (index $existingConfig "remoteControlHostname") -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $_ := unset $userSettings "globalPermissionGrants" -}}
{
  "model": "Gemini 3.8 Flash (Medium)",
  "enableTelemetry": false,
  "statusLine": {
    "type": "",
    "command": "",
    "enabled": true,
    "stack_with_default": true
  },
  "toolPermission": "proceed-in-sandbox",
  "trustedWorkspaces": [
    "{{ .chezmoi.sourceDir }}"
  ],
  "userSettings": {
    {{- range $k, $v := $userSettings }}
    {{ $k | toJson }}: {{ $v | toJson }},
    {{- end }}
    {{ template "commands/antigravity.tmpl" . }}
  },
  "useG1Credits": false,
  "useAiCredits": false,
  "queuedMessages": "queue",
  "verbosity": "medium",
  "pickerGrouping": "workspace",
  "copyOnSelect": true
}