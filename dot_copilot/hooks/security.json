{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "$HOME/.copilot/hooks/ai-guard-wrapper.sh prompt",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "runTerminalCommand|run_in_terminal|bash|terminal|execute_command",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.copilot/hooks/ai-guard-wrapper.sh command",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.copilot/hooks/ai-guard-wrapper.sh file",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
