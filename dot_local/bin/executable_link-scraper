#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || -z "${1:-}" ]]; then
    printf 'Usage: %s <URL>\n' "$(basename -- "$0")" >&2
    exit 1
fi

URL="$1"

# SECURITY: Use '--' before "$URL" to prevent option injection into lynx
# PERF: Strip leading counter/whitespace while preserving URLs that contain spaces or fragments.
# Consolidating the dual-awk pipeline into a single awk process eliminates a redundant fork
# and pipeline IPC buffering.
exec lynx -dump -hiddenlinks=listonly -- "$URL" | awk 'NF >= 2 { sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, ""); print }'
