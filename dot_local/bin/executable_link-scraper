#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || -z "${1:-}" ]]; then
    printf 'Usage: %s <URL>\n' "$(basename -- "$0")" >&2
    exit 1
fi

URL="$1"

# SECURITY: Use '--' before "$URL" to prevent option injection into lynx
exec lynx -dump -hiddenlinks=listonly -- "$URL" | awk '{$1=""}1' | awk '{$1=$1}1'
