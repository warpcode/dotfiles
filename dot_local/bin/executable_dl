#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || -z "${1:-}" ]]; then
    printf 'Usage: %s <URL> [SAVETO]\n' "$(basename -- "$0")" >&2
    exit 1
fi

URL="$1"
SAVETO="${2:-}"

# Safely percent-decode URL path for default filename, stripping null bytes and avoiding echo -e escape expansion
urldecode() {
    python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]).replace("\x00", ""))' "$1"
}

if [[ -z "$SAVETO" ]]; then
    # Strip URL query parameters or fragments before determining basename
    clean_url="${URL%%\?*}"
    clean_url="${clean_url%%\#*}"
    # PERF: Fast substring check to bypass python3 subshell startup (~200ms)
    # when the URL path contains no percent-encoded characters.
    if [[ "$clean_url" == *%* ]]; then
        decoded_url="$(urldecode "$clean_url")"
    else
        decoded_url="$clean_url"
    fi
    SAVETO="$(basename -- "$decoded_url")"
    if [[ -z "$SAVETO" || "$SAVETO" == "/" || "$SAVETO" == "." ]]; then
        SAVETO="download"
    fi
fi

# SECURITY: Use '--' before "$URL" to prevent option injection into wget
exec wget -O "$SAVETO" -q --show-progress --retry-connrefused --waitretry=1 --read-timeout=20 --timeout=15 -t 0 -- "$URL"
