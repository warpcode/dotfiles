#!/usr/bin/env python3
"""df.ai-guard - Unified security guard and lifecycle gate for AI coding assistants."""

import glob
import json
import os
import re
import shlex
import sys
import unicodedata
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import unquote, urlparse

PROMPT_KEYS = ("prompt", "user_prompt", "userPrompt", "message", "userMessage", "text", "content")
PATH_KEYS = (
    "AbsolutePath", "TargetFile", "filePath", "path", "file", "target_file", "targetFile",
    "filename", "file_path", "src", "dest", "source", "destination", "DirectoryPath",
    "SearchPath", "SearchDirectory", "TargetDirectory", "Uri", "uri", "resourceUri",
    "cwd", "Cwd", "dir", "directory", "path_to_file", "filepath", "dest_file", "source_file"
)
CMD_KEYS = ("CommandLine", "commandLine", "command", "cmd", "input")
CWD_KEYS = ("Cwd", "cwd", "DirectoryPath", "directory", "dir", "workspaceRoot", "directoryPath")
CONTAINER_KEYS = ("toolCall", "tool_input", "toolArgs", "tool_args", "tool_use", "args", "arguments", "params", "parameters")
OUTPUT_KEYS = (
    "toolResult", "tool_result", "result", "output", "response", "content",
    "stdout", "stderr", "data", "text", "message"
)


def load_config(custom_path: str | None = None) -> dict:
    def _load_raw(path: Path) -> dict:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)

    def _expand_secrets(cfg: dict) -> dict:
        """Append shared secrets rules into both prompts and output sections."""
        shared = cfg.get("secrets", {}).get("rules", [])
        if not shared:
            return cfg
        for section in ("prompts", "output"):
            cfg.setdefault(section, {}).setdefault("rules", [])
            cfg[section]["rules"] = cfg[section]["rules"] + shared
        return cfg

    if custom_path:
        p = Path(custom_path)
        if not p.is_file():
            sys.stderr.write(f"Custom config file not found: {custom_path}\n")
            sys.exit(1)
        try:
            return _expand_secrets(_load_raw(p))
        except Exception as e:
            sys.stderr.write(f"Error loading custom config {custom_path}: {e}\n")
            sys.exit(1)

    for c in [
        os.environ.get("XDG_CONFIG_HOME") and Path(os.environ["XDG_CONFIG_HOME"]) / "dotfiles/ai-guard.json",
        Path.home() / ".config/dotfiles/ai-guard.json",
        Path(__file__).resolve().parent.parent.parent / "dot_config/dotfiles/ai-guard.json"
    ]:
        if c and Path(c).is_file():
            try:
                return _expand_secrets(_load_raw(Path(c)))
            except Exception:
                pass
    return {"commands": {"rules": []}, "files": {"rules": []}, "prompts": {"rules": []}, "output": {"rules": []}}


def normalize_rules(data: dict | list) -> list[dict]:
    raw = data if isinstance(data, list) else data.get("rules", []) if isinstance(data, dict) else []
    res = []
    for r in raw:
        if isinstance(r, str):
            res.append({"pattern": r.strip(), "perm": "deny", "reason": f"Matched pattern: {r.strip()}"})
        elif isinstance(r, dict):
            perm = (r.get("perm") or r.get("permission") or "deny").lower()
            if perm not in ("deny", "replace"):
                continue
            # Only regex is supported; reject rules specifying any non-regex match type
            m = r.get("match")
            if m and m.lower() != "regex":
                continue
            entry = {
                "pattern": r.get("pattern", ""),
                "perm": perm,
            }
            if "reason" in r:
                entry["reason"] = r["reason"]
            elif perm != "replace":
                entry["reason"] = ""
            if "replace" in r:
                entry["replace"] = r["replace"]
            res.append(entry)
    return res


def clean_path(raw: str) -> str:
    if not raw or not isinstance(raw, str):
        return ""
    val = raw.strip()
    if val.startswith("file://"):
        try:
            val = unquote(urlparse(val).path)
        except Exception:
            val = val[7:]
    if "=" in val and not os.path.exists(val):
        val = val.split("=", 1)[1]
    return val.strip("'\"()[]{} \t\n\r").lstrip("@<>").strip("'\"()[]{} \t\n\r")


def match_str(cand: str, pat: str) -> bool:
    cand, pat = cand.strip(), pat.strip()
    if not cand or not pat:
        return False
    ce, pe = os.path.expandvars(os.path.expanduser(cand)), os.path.expandvars(os.path.expanduser(pat))
    try:
        return bool(re.search(pat, cand) or re.search(pat, ce) or re.search(pe, cand) or re.search(pe, ce))
    except Exception:
        return False


def match_file(path_str: str, rule: dict, cwd: str | None = None) -> tuple[bool, str]:
    pat = rule.get("pattern", "")
    cand = clean_path(path_str)
    if not cand or not pat:
        return False, ""
    rsn = rule.get("reason", f"Access to sensitive file '{path_str}' is blocked.")

    exp = os.path.expandvars(os.path.expanduser(cand))
    if cwd and not os.path.isabs(exp):
        exp = os.path.join(cwd, exp)
    norm = os.path.normpath(exp)

    exp_pat = os.path.expandvars(os.path.expanduser(pat))

    try:
        if re.search(pat, cand) or re.search(pat, norm) or re.search(exp_pat, cand) or re.search(exp_pat, norm):
            return True, rsn
    except Exception:
        pass
    return False, ""


def find_rule(cand: str | list[str], rules: list[dict], perm: str, d_rsn: str = "Forbidden") -> tuple[dict, str, str] | None:
    cands = cand if isinstance(cand, list) else [cand]
    for c in cands:
        for r in rules:
            if r.get("perm") == perm:
                if match_str(c, r.get("pattern", "")):
                    rsn = r.get("reason") or d_rsn
                    return r, c, f"{rsn} ({c})"
    return None


def emit(decision: str, reason: str, extra: dict | None = None) -> None:
    payload = {"decision": decision, "permissionDecision": decision}
    if reason:
        payload["reason"] = reason
    if decision == "deny":
        msg = f"SECURITY GUARD: {reason}"
        payload.update({"decision": "deny", "permissionDecision": "deny", "permissionDecisionReason": msg,
                        "allow": False, "permission": "deny", "reason": msg})
        if extra:
            payload.update(extra)
        print(json.dumps(payload, indent=2))
        sys.stderr.write(f"{msg}\n")
        sys.exit(2)

    if decision == "replace":
        payload.update({"allow": True, "permission": "allow", "permissionDecision": "allow"})
    if extra:
        payload.update(extra)
    print(json.dumps(payload, indent=2))
    sys.exit(0)


# ==============================================================================
# Command Parser Engine
# ==============================================================================

@dataclass
class ParsedCommand:
    segments: list[list[str]] = field(default_factory=list)
    operators: list[str] = field(default_factory=list)
    file_targets: list[str] = field(default_factory=list)
    subshells: list[str] = field(default_factory=list)
    raw: str = ""
    error: str | None = None


class CommandParser:
    SEPARATORS = {";", "&&", "||", "|", "&", ";;", "\n", "\r"}
    REDIRECTIONS = {">", ">>", "<", "<<", "2>", "1>", "2>>", "1>>", "&>", ">|", "<<<"}

    @staticmethod
    def _is_escaped(t: str, i: int) -> bool:
        b, j = 0, i - 1
        while j >= 0 and t[j] == "\\":
            b, j = b + 1, j - 1
        return b % 2 == 1

    @classmethod
    def extract_subshells(cls, text: str) -> list[str]:
        sub_cmds, i, n = [], 0, len(text)
        while i < n:
            is_sub = (text[i:i + 2] == "$(") and not cls._is_escaped(text, i)
            is_proc = (i > 0 and text[i - 1] in "<>" and text[i] == "(") and not cls._is_escaped(text, i - 1)
            if is_sub or is_proc:
                start, depth = (i + 2 if is_sub else i + 1), 1
                j, in_sq, in_dq = start, False, False
                while j < n and depth > 0:
                    c = text[j]
                    if c == "\\" and not in_sq:
                        j += 2
                        continue
                    if c == "'" and not in_dq:
                        in_sq = not in_sq
                    elif c == '"' and not in_sq:
                        in_dq = not in_dq
                    elif not in_sq and not in_dq:
                        depth += 1 if c == "(" else -1 if c == ")" else 0
                    j += 1
                if depth == 0:
                    inner = text[start:j - 1].strip()
                    if inner:
                        sub_cmds.append(inner)
                        sub_cmds.extend(cls.extract_subshells(inner))
                    i = j
                    continue
            elif text[i] == "`" and not cls._is_escaped(text, i):
                j = i + 1
                while j < n and text[j] != "`":
                    j += 2 if text[j] == "\\" else 1
                if j < n:
                    inner = text[i + 1:j].strip()
                    if inner:
                        sub_cmds.append(inner)
                        sub_cmds.extend(cls.extract_subshells(inner))
                    i = j + 1
                    continue
            i += 1
        return sub_cmds

    @classmethod
    def tokenize(cls, text: str) -> list[str]:
        norm, in_sq, in_dq, i, n = [], False, False, 0, len(text)
        while i < n:
            c = text[i]
            if c == "\\" and not in_sq:
                norm.extend([c, text[i + 1]] if i + 1 < n else [c])
                i += 2
                continue
            if c == "'" and not in_dq:
                in_sq = not in_sq
            elif c == '"' and not in_sq:
                in_dq = not in_dq
            elif c in ("\n", "\r") and not in_sq and not in_dq:
                c = ";"
            norm.append(c)
            i += 1
        cleaned = "".join(norm)
        try:
            s = shlex.shlex(cleaned, posix=True, punctuation_chars=True)
            s.whitespace_split, s.commenters = True, ""
            return list(s)
        except Exception:
            try:
                return shlex.split(cleaned, posix=True)
            except Exception:
                return cleaned.split()

    @classmethod
    def parse(cls, cmd_str: str) -> ParsedCommand:
        raw = cmd_str.strip()
        if not raw:
            return ParsedCommand(raw=raw)

        for c in raw:
            code, cat = ord(c), unicodedata.category(c)
            if code < 32 and c not in (" ", "\t", "\n", "\r"):
                return ParsedCommand(raw=raw, error="Command contains illegal control characters.")
            if c not in ("\t", "\n", "\r") and cat in ("Cc", "Cf", "Zl", "Zp"):
                return ParsedCommand(raw=raw, error="Command contains hidden unicode line or control separators.")

        p = ParsedCommand(raw=raw, subshells=cls.extract_subshells(raw))
        for sub in p.subshells:
            sr = cls.parse(sub)
            if sr.error:
                return ParsedCommand(raw=raw, error=sr.error)
            p.segments.extend(sr.segments)
            p.file_targets.extend(sr.file_targets)

        tokens = cls.tokenize(raw)
        curr, is_redir = [], False
        for t in tokens:
            if t in cls.REDIRECTIONS:
                is_redir = True
                p.operators.append(t)
                if curr:
                    p.segments.append(curr)
                    curr = []
            elif t in cls.SEPARATORS:
                is_redir = False
                p.operators.append(t)
                if curr:
                    p.segments.append(curr)
                    curr = []
            else:
                if is_redir:
                    p.file_targets.append(t)
                    is_redir = False
                else:
                    curr.append(t)
        if curr:
            p.segments.append(curr)

        # Check for shell -c and find -exec command invocations
        extra_segments = []
        for seg in p.segments:
            variants = unwrap_command_tokens(seg)
            for var in variants:
                if not var:
                    continue
                cmd_base = os.path.basename(var[0])
                if cmd_base in ("bash", "sh", "zsh", "dash"):
                    for idx, tok in enumerate(var):
                        if tok in ("-c", "-ec", "-ce", "-cx", "-xc") and idx + 1 < len(var):
                            cmd_arg = var[idx + 1]
                            nested_p = cls.parse(cmd_arg)
                            if nested_p.error:
                                return ParsedCommand(raw=raw, error=nested_p.error)
                            extra_segments.extend(nested_p.segments)
                            p.file_targets.extend(nested_p.file_targets)
                            break
                elif cmd_base == "find":
                    for idx, tok in enumerate(var):
                        if tok in ("-exec", "-execdir", "-ok", "-okdir") and idx + 1 < len(var):
                            sub_toks = []
                            for t in var[idx + 1:]:
                                if t in (";", "\\;", "+"):
                                    break
                                sub_toks.append(t)
                            if sub_toks:
                                nested_find_p = cls.parse(" ".join(sub_toks))
                                if nested_find_p.error:
                                    return ParsedCommand(raw=raw, error=nested_find_p.error)
                                extra_segments.extend(nested_find_p.segments)
                                p.file_targets.extend(nested_find_p.file_targets)
                            break
        p.segments.extend(extra_segments)
        return p


# ==============================================================================
# Unified Payload Extraction
# ==============================================================================

@dataclass
class PayloadContext:
    command: str = ""
    file_targets: list[str] = field(default_factory=list)
    prompt: str = ""
    output: str = ""
    cwd: str = ""
    original_payload: dict | list | str | None = None


def extract_context(payload: dict | list | str | None, cli_args: list[str]) -> PayloadContext:
    ctx = PayloadContext(original_payload=payload, cwd=os.getcwd())
    if cli_args:
        ctx.file_targets.extend(cli_args)
        ctx.command = ctx.prompt = ctx.output = " ".join(cli_args)
    if not payload:
        return ctx
    if isinstance(payload, str):
        ctx.command, ctx.prompt, ctx.output = payload.strip(), payload, payload
        ctx.file_targets.append(payload)
        return ctx
    if isinstance(payload, list):
        for item in payload:
            sub = extract_context(item, [])
            ctx.file_targets.extend(sub.file_targets)
            ctx.command = ctx.command or sub.command
            ctx.prompt = ctx.prompt or sub.prompt
            ctx.output = ctx.output or sub.output
        return ctx

    containers, stack = [], [payload]
    while stack:
        curr = stack.pop()
        if isinstance(curr, dict):
            containers.append(curr)
            for k in CONTAINER_KEYS:
                if isinstance(curr.get(k), dict):
                    stack.append(curr[k])

    for d in containers:
        if ctx.cwd == os.getcwd():
            for k in CWD_KEYS:
                if isinstance(d.get(k), str) and d[k].strip():
                    ctx.cwd = os.path.expandvars(os.path.expanduser(d[k].strip()))
                    break
        if not ctx.command:
            for k in CMD_KEYS:
                v = d.get(k)
                if isinstance(v, str) and v.strip():
                    ctx.command = v.strip()
                    break
                elif isinstance(v, list):
                    ctx.command = " ".join(str(x) for x in v).strip()
                    break
        for k in PATH_KEYS:
            if isinstance(d.get(k), str) and d[k].strip():
                ctx.file_targets.append(d[k])
        for lk in ("paths", "files", "targets"):
            if isinstance(d.get(lk), list):
                ctx.file_targets.extend(x for x in d[lk] if isinstance(x, str))
        if not ctx.prompt:
            for k in PROMPT_KEYS:
                if isinstance(d.get(k), str) and d[k].strip():
                    ctx.prompt = d[k]
                    break
        if not ctx.output:
            for k in OUTPUT_KEYS:
                v = d.get(k)
                if isinstance(v, str) and v.strip():
                    ctx.output = v
                    break
                elif isinstance(v, (dict, list)):
                    ctx.output = json.dumps(v)
                    break

    if not ctx.prompt:
        msgs = payload.get("messages")
        if isinstance(msgs, list) and msgs and isinstance(msgs[-1], dict):
            last = msgs[-1]
            ctx.prompt = str(last.get("content") or last.get("text") or last.get("userMessage") or "")
        elif isinstance(payload.get("parts"), list):
            ctx.prompt = "\n".join(str(p.get("text", "")) for p in payload["parts"] if isinstance(p, dict))

    if ctx.command:
        parsed = CommandParser.parse(ctx.command)
        for seg in parsed.segments:
            for tok in seg:
                ctx.file_targets.append(tok)
                if any(c in tok for c in ("*", "?", "[")):
                    if tok.startswith("/**") or tok.startswith("/*") or "**" in tok:
                        continue
                    try:
                        exp = os.path.expandvars(os.path.expanduser(tok))
                        m = glob.glob(exp) if os.path.isabs(exp) else glob.glob(tok, root_dir=ctx.cwd)
                        ctx.file_targets.extend(m[:100] if os.path.isabs(exp) else [os.path.join(ctx.cwd, x) for x in m[:100]])
                    except Exception:
                        pass
        ctx.file_targets.extend(parsed.file_targets)
    return ctx


# ==============================================================================
# Security Evaluators
# ==============================================================================

WRAPPER_COMMANDS = {"sudo", "doas", "nohup", "nice", "time", "command", "builtin", "exec", "xargs"}


def unwrap_command_tokens(tokens: list[str]) -> list[list[str]]:
    """Return all command variants by unwrapping prefixes like sudo, env, nohup, grouping parens, etc."""
    variants = [tokens]
    curr = tokens[:]
    while curr:
        # Unwrap subshell grouping parens and braces: (cmd), { cmd; }
        if curr[0] in ("(", "{"):
            curr = curr[1:]
            if curr and curr[-1] in (")", "}"):
                curr = curr[:-1]
            if curr:
                variants.append(curr)
                continue
            break
        first = os.path.basename(curr[0])
        if first == "env":
            idx = 1
            while idx < len(curr):
                t = curr[idx]
                if t in ("-i", "--ignore-environment", "-0", "--null"):
                    idx += 1
                elif t in ("-u", "--unset", "-C", "--chdir") and idx + 1 < len(curr):
                    idx += 2
                elif "=" in t and not t.startswith("-"):
                    idx += 1
                elif t.startswith("-"):
                    idx += 1
                else:
                    break
            if idx < len(curr) and curr[idx:] != curr:
                curr = curr[idx:]
                variants.append(curr)
                continue
            break
        elif first in WRAPPER_COMMANDS:
            idx = 1
            while idx < len(curr) and curr[idx].startswith("-"):
                if curr[idx] in ("-u", "-g", "-p", "-C", "-D", "-n", "-I", "-E", "-a", "-d", "-s", "-L") and idx + 1 < len(curr) and not curr[idx + 1].startswith("-"):
                    idx += 2
                else:
                    idx += 1
            if idx < len(curr) and curr[idx:] != curr:
                curr = curr[idx:]
                variants.append(curr)
                continue
            break
        else:
            break
    return variants


def extract_candidate_paths(tok: str) -> list[str]:
    cands = [tok]
    if "=" in tok:
        cands.append(tok.split("=", 1)[1])
    if tok.startswith("@"):
        cands.append(tok[1:])
    elif tok.startswith("-"):
        stripped = tok.lstrip("-")
        if "=" in stripped:
            cands.append(stripped.split("=", 1)[1])
        elif len(stripped) > 1 and stripped[0].isalpha() and (stripped[1] in ("/", ".", "~") or os.path.sep in stripped):
            cands.append(stripped[1:])
    return [c for c in cands if c]


def eval_segment(tokens: list[str], rules: list[dict], file_deny: list[dict], cwd: str | None) -> tuple[str, str, dict | None]:
    if not tokens:
        return "none", "", None

    variants = unwrap_command_tokens(tokens)

    # 1. Deny checks on file targets and tokens across all variants (and unwrap)
    for var in variants:
        hit = find_rule(var, file_deny, "deny", d_rsn="Access to sensitive file blocked")
        if hit:
            return "deny", hit[2], hit[0]
        for tok in var:
            for cand_path in extract_candidate_paths(tok):
                dec, rsn, r = eval_file_target(cand_path, file_deny, cwd=cwd)
                if dec == "deny":
                    return "deny", f"{rsn} ({tok})", r

    # 2. Deny checks on command strings across all variants (so sudo rm -rf / is denied)
    for var in variants:
        cmd_repr = " ".join(var)
        hit = find_rule(cmd_repr, rules, "deny", d_rsn="Command is forbidden")
        if hit:
            return "deny", hit[2], hit[0]

    # 3. Replace checks
    full_cmd_repr = " ".join(tokens)
    for r in rules:
        if r.get("perm") == "replace":
            try:
                if re.search(r.get("pattern", ""), full_cmd_repr):
                    rsn = r.get("reason") or "Command modified"
                    return "replace", f"{rsn} ({full_cmd_repr})", r
            except Exception:
                pass

    return "none", "", None


def eval_file_target(target: str, rules: list[dict], cwd: str | None) -> tuple[str, str, dict | None]:
    cand = clean_path(target)
    if not cand:
        return "none", "", None
    rp = None
    try:
        exp = os.path.expandvars(os.path.expanduser(cand))
        if cwd and not os.path.isabs(exp):
            exp = os.path.join(cwd, exp)
        if os.path.islink(cand) or os.path.islink(exp) or os.path.exists(exp):
            real = os.path.realpath(exp)
            if real != os.path.normpath(exp):
                rp = real
    except Exception:
        pass

    for p in ("deny", "replace"):
        for r in rules:
            if r.get("perm") == p:
                m, rsn = match_file(cand, r, cwd=cwd)
                if m:
                    return p, rsn, r
                if p == "deny" and rp:
                    m_sym, rsn_sym = match_file(rp, r, cwd=cwd)
                    if m_sym:
                        return "deny", f"Symlink targets protected path: {rsn_sym}", r
    return "none", "", None


# ==============================================================================
# Subcommand Handlers & CLI
# ==============================================================================

def handle_command(config: dict, ctx: PayloadContext) -> None:
    if not ctx.command:
        print("{}")
        sys.exit(0)
    raw = ctx.command.strip()
    cmd_rules = normalize_rules(config.get("commands", {}))
    file_rules = normalize_rules(config.get("files", {}))
    cmd_deny = [r for r in cmd_rules if r.get("perm") == "deny"]
    file_deny = [r for r in file_rules if r.get("perm") == "deny"]
    all_deny = cmd_deny + file_deny

    hit = find_rule(raw, all_deny, "deny", d_rsn="Forbidden command pattern")
    if hit:
        emit("deny", hit[2])

    p = CommandParser.parse(raw)
    if p.error:
        emit("deny", p.error)
    if not p.segments and not p.file_targets:
        print("{}")
        sys.exit(0)

    for tgt in p.file_targets:
        dec, rsn, _ = eval_file_target(tgt, file_rules, cwd=ctx.cwd)
        if dec == "deny":
            emit("deny", f"Access to sensitive file blocked ({rsn})")
        hit = find_rule(tgt, file_deny, "deny", d_rsn="Access to sensitive file blocked")
        if hit:
            emit("deny", hit[2])

    actions = [eval_segment(seg, cmd_rules, file_deny, ctx.cwd) for seg in p.segments]
    for act, rsn, _ in actions:
        if act == "deny":
            emit("deny", rsn)

    replaces = [r for act, _, r in actions if act == "replace" and r]
    if replaces:
        mod = raw
        reasons = []
        for r in replaces:
            try:
                mod = re.sub(r["pattern"], r["replace"], mod)
                reasons.append(r.get("reason") or "Command modified")
            except Exception:
                pass
        extra = {"command": mod, "CommandLine": mod, "modified": mod, "overwrite": {"CommandLine": mod, "command": mod}}
        if isinstance(ctx.original_payload, dict):
            for k in CMD_KEYS:
                if k in ctx.original_payload:
                    ctx.original_payload[k] = mod
            extra["payload"] = ctx.original_payload
        emit("replace", "; ".join(reasons), extra)

    print("{}")
    sys.exit(0)


def handle_file(config: dict, ctx: PayloadContext) -> None:
    if not ctx.file_targets:
        print("{}")
        sys.exit(0)
    file_rules = normalize_rules(config.get("files", {}))
    results = [eval_file_target(t, file_rules, ctx.cwd) + (t,) for t in ctx.file_targets]

    for dec, rsn, _, t in results:
        if dec == "deny":
            emit("deny", f"Access to sensitive file or path '{t}' is blocked ({rsn}).")
    for dec, rsn, r, t in results:
        if dec == "replace":
            new_t = re.sub(r["pattern"], r["replace"], t)
            emit("replace", rsn, {"replacement": new_t, "path": new_t, "target": new_t})
    print("{}")
    sys.exit(0)


def handle_prompt(config: dict, ctx: PayloadContext) -> None:
    text = ctx.prompt
    if not text:
        print("{}")
        sys.exit(0)
    rules = normalize_rules(config.get("prompts", {}))
    for r in rules:
        pat = r.get("pattern")
        if r.get("perm") == "deny" and pat and re.search(pat, text):
            rsn = r.get("reason", "Prompt submission blocked")
            emit("deny", f"Prompt submission blocked ({rsn})")

    sanitized, applied = text, []
    for r in rules:
        pat = r.get("pattern")
        if r.get("perm") == "replace" and pat:
            try:
                if re.search(pat, sanitized):
                    sanitized = re.sub(pat, r.get("replace", "[REDACTED]"), sanitized)
                    applied.append(r.get("reason") or "Sensitive data redacted")
            except Exception:
                pass
    if applied:
        notice = f"Security Notice: {len(applied)} sensitive item(s) redacted ({', '.join(sorted(list(set(applied))))})."
        extra = {"sanitized": sanitized, "text": sanitized, "reasons": applied,
                 "systemMessage": notice, "additionalContext": notice, "injectSteps": [{"ephemeralMessage": notice}]}
        for k in PROMPT_KEYS:
            extra[k] = sanitized
        if isinstance(ctx.original_payload, dict):
            for k in PROMPT_KEYS:
                if k in ctx.original_payload:
                    ctx.original_payload[k] = sanitized
            extra["payload"] = ctx.original_payload
        emit("replace", "; ".join(sorted(list(set(applied)))), extra)

    print("{}")
    sys.exit(0)


def redact_text_and_report(text: str, rules: list[dict]) -> tuple[str, list[str]]:
    if not text or not isinstance(text, str):
        return text, []
    sanitized = text
    applied = []
    for r in rules:
        pat = r.get("pattern")
        if not pat:
            continue
        perm = r.get("perm")
        if perm == "deny":
            try:
                if re.search(pat, sanitized):
                    rsn = r.get("reason", "Blocked sensitive content")
                    repl = r.get("replace", "[REDACTED_BLOCKED_SECRET]")
                    sanitized = re.sub(pat, repl, sanitized)
                    applied.append(rsn)
            except Exception:
                pass
        elif perm == "replace":
            try:
                if re.search(pat, sanitized):
                    repl = r.get("replace", "[REDACTED]")
                    sanitized = re.sub(pat, repl, sanitized)
                    applied.append(r.get("reason") or "Sensitive data redacted")
            except Exception:
                pass
    return sanitized, applied


def sanitize_value(val: any, rules: list[dict], applied_reasons: list[str]) -> any:
    if isinstance(val, str):
        s, app = redact_text_and_report(val, rules)
        applied_reasons.extend(app)
        return s
    elif isinstance(val, dict):
        return {k: sanitize_value(v, rules, applied_reasons) for k, v in val.items()}
    elif isinstance(val, list):
        return [sanitize_value(item, rules, applied_reasons) for item in val]
    return val


def handle_output(config: dict, ctx: PayloadContext) -> None:
    rules = normalize_rules(config.get("output", {}))
    prompt_rules = normalize_rules(config.get("prompts", {}))
    combined_rules = rules + [r for r in prompt_rules if r.get("perm") in ("replace", "deny")]

    applied_reasons = []

    if isinstance(ctx.original_payload, dict):
        sanitized_payload = sanitize_value(ctx.original_payload, combined_rules, applied_reasons)
        if applied_reasons:
            reasons_unique = sorted(list(set(applied_reasons)))
            notice = f"Security Notice: Redacted sensitive items in tool output ({', '.join(reasons_unique)})."
            primary_text, _ = redact_text_and_report(ctx.output, combined_rules)
            extra_overwrite = {}
            for k in OUTPUT_KEYS:
                if k in sanitized_payload:
                    extra_overwrite[k] = sanitized_payload[k]
            if not extra_overwrite and primary_text:
                extra_overwrite = {"toolResult": primary_text, "result": primary_text, "output": primary_text}

            extra = {
                "decision": "replace",
                "allow": True,
                "permission": "allow",
                "permissionDecision": "allow",
                "sanitized": primary_text or notice,
                "reasons": reasons_unique,
                "reason": "; ".join(reasons_unique),
                "systemMessage": notice,
                "payload": sanitized_payload,
                "overwrite": extra_overwrite
            }
            for k in OUTPUT_KEYS:
                if k in sanitized_payload:
                    extra[k] = sanitized_payload[k]
                elif primary_text and k in ("toolResult", "result", "output"):
                    extra[k] = primary_text
            print(json.dumps(extra, indent=2))
            sys.exit(0)
        print("{}")
        sys.exit(0)

    text_to_check = ctx.output or ctx.prompt or ctx.command
    if not text_to_check:
        print("{}")
        sys.exit(0)

    sanitized, applied = redact_text_and_report(text_to_check, combined_rules)
    if applied:
        reasons_unique = sorted(list(set(applied)))
        notice = f"Security Notice: Redacted sensitive items in tool output ({', '.join(reasons_unique)})."
        extra = {
            "decision": "replace",
            "allow": True,
            "permission": "allow",
            "permissionDecision": "allow",
            "sanitized": sanitized,
            "text": sanitized,
            "reasons": reasons_unique,
            "reason": "; ".join(reasons_unique),
            "systemMessage": notice,
            "overwrite": {"toolResult": sanitized, "result": sanitized, "output": sanitized}
        }
        for k in OUTPUT_KEYS:
            extra[k] = sanitized
        print(json.dumps(extra, indent=2))
        sys.exit(0)

    print("{}")
    sys.exit(0)


def handle_parse(ctx: PayloadContext, cli_args: list[str]) -> None:
    cmd = ctx.command or (" ".join(cli_args) if cli_args else "")
    if not cmd:
        print(json.dumps({"segments": [], "operators": [], "file_targets": [], "subshells": [], "raw": ""}, indent=2))
        sys.exit(0)
    p = CommandParser.parse(cmd)
    if p.error:
        print(json.dumps({"error": p.error, "decision": "deny"}, indent=2))
        sys.exit(2)
    print(json.dumps({"segments": p.segments, "operators": p.operators, "file_targets": p.file_targets, "subshells": p.subshells, "raw": p.raw}, indent=2))
    sys.exit(0)


def main():
    args, custom_config = sys.argv[1:], None
    idx = 0
    while idx < len(args):
        if args[idx] in ("-c", "--config"):
            if idx + 1 < len(args):
                custom_config, idx = args[idx + 1], idx + 2
            else:
                sys.stderr.write("Error: -c / --config requires a configuration file path.\n")
                sys.exit(1)
        else:
            break

    sub_args = args[idx:]
    if not sub_args:
        sys.stderr.write("Usage: df.ai-guard [-c <config_path>] <subcommand> [args...]\n")
        sys.exit(1)
    subcmd, rest = sub_args[0], sub_args[1:]
    valids = ("command", "file", "prompt", "output", "scrub", "sanitize", "parse")
    if subcmd not in valids:
        sys.stderr.write(f"Unknown subcommand '{subcmd}'. Supported subcommands: {', '.join(valids)}\n")
        sys.exit(1)

    payload = None
    if not sys.stdin.isatty():
        try:
            raw = sys.stdin.read()
            if raw.strip():
                try:
                    payload = json.loads(raw)
                except Exception:
                    payload = None if raw.strip().startswith(("{", "[")) else raw.strip()
        except Exception:
            pass

    ctx = extract_context(payload, rest)
    if subcmd == "parse":
        handle_parse(ctx, rest)
    config = load_config(custom_config)
    if subcmd == "command":
        handle_command(config, ctx)
    elif subcmd == "file":
        handle_file(config, ctx)
    elif subcmd == "prompt":
        handle_prompt(config, ctx)
    elif subcmd in ("output", "scrub", "sanitize"):
        handle_output(config, ctx)


if __name__ == "__main__":
    main()
