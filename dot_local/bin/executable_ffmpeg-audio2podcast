#!/usr/bin/env bash

if [[ "$1" == '' ]]
then
    echo "No Source specified"
    exit 1
fi

# Security: validate input file presence and existence before processing
if [[ ! -f "$1" ]]
then
    echo "Source '$1' does not exist or is not a file" >&2
    exit 1
fi

# Normalize relative paths starting with '-' to prevent ffmpeg option injection
SOURCE="$1"
if [[ "$SOURCE" == -* ]]
then
    SOURCE="./$SOURCE"
fi

if ffmpeg -i "$SOURCE" 2>&1 | grep 'Invalid data found'		#check if it's video file
then
   echo "$1 is NOT A VALID FILE!"
   exit 1
fi

if [[ "$2" == '' ]]
then
    echo "No Output specified"
    exit 1
fi

OUTPUT="$2"
if [[ "$OUTPUT" == -* ]]
then
    OUTPUT="./$OUTPUT"
fi

if [[ ! "${2##*.}" == 'mp4' ]] && [[ ! "${2##*.}" == 'm4a' ]]
then
    echo "Output file must end with mp4 or m4a"
    exit 1
fi

# Check FFMPEG Installation
if ffmpeg -formats 2> /dev/null | grep "E mp4" > /dev/null
	then
	 echo "Check mp4 container format ... OK"
	else
	 echo "Check mp4 container format ... NOK"
	 exit
fi

if ffmpeg -codecs 2> /dev/null | grep "libfdk_aac" > /dev/null
    then
    AAC_LIB="libfdk_aac"
elif ffmpeg -codecs 2> /dev/null | grep "libfaac" > /dev/null
    then
    AAC_LIB="libfaac"
else
    AAC_LIB="aac -strict -2"
fi

echo "Using aac encoder: $AAC_LIB"

ffmpeg -y -v error -stats -i "$SOURCE" -vn -sn -c:a $AAC_LIB -b:a 32k -ac 2 "$OUTPUT" < /dev/null
echo ""
