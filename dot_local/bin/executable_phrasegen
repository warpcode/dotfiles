#!/usr/bin/env bash

# Security: validate words parameter to prevent option injection and resource exhaustion (CWE-20 / CWE-400)
if [[ $# -ge 1 && -z "$1" ]]; then
    echo "Usage: phrasegen [words (1-1000)] [delimiter]" >&2
    exit 1
fi

words="${1:-4}"
if [[ ! "$words" =~ ^[1-9][0-9]*$ ]] || (( words > 1000 )); then
    echo "Usage: phrasegen [words (1-1000)] [delimiter]" >&2
    exit 1
fi

# Sanitize delimiter: default to single space, disallow newline characters to prevent command breakage
delimiter="${2:- }"
if [[ "$delimiter" =~ [$'\n'] ]]; then
    echo "phrasegen: delimiter cannot contain newline characters" >&2
    exit 1
fi

# Ensure wordlist directory and files exist
wordlist_dir="${XDG_CONFIG_HOME:-${HOME}/.config}/dotfiles/wordlists"
shopt -s nullglob
wordlists=("${wordlist_dir}"/google-10000-english-usa-no-swears-*.txt)
shopt -u nullglob

if (( ${#wordlists[@]} == 0 )); then
    echo "phrasegen: no wordlist files found in ${wordlist_dir}" >&2
    exit 1
fi

# Determine the best available random shuffling tool
if command -v shuf >/dev/null 2>&1; then
    shuffle_cmd=(shuf -n "${words}")
    [[ -e /dev/urandom ]] && shuffle_cmd+=(--random-source=/dev/urandom)
elif command -v gshuf >/dev/null 2>&1; then
    shuffle_cmd=(gshuf -n "${words}")
    [[ -e /dev/urandom ]] && shuffle_cmd+=(--random-source=/dev/urandom)
else
    # Fallback to sort -R if shuf is not available.
    # Note: sort -R is less efficient as it sorts the entire input.
    shuffle_cmd=(sort -R)
fi

exec cat -- "${wordlists[@]}" \
    | "${shuffle_cmd[@]}" \
    | head -n "${words}" \
    | paste -s -d "${delimiter}" -
