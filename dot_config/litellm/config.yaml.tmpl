model_list:
  - model_name: "*"
    litellm_params:
      model: "openrouter/*"
      additional_drop_params: ["reasoningSummary"]

litellm_settings:
  drop_params: true
  check_provider_endpoint: true
  route_all_chat_openai_to_responses: true

general_settings:
  model_list_healthy_only: true
  background_health_checks: true