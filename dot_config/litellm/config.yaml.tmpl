litellm_settings:
  drop_params: true
  check_provider_endpoint: true

model_list:
{{- range $providerKey, $provider := .providers }}
  {{- if eq $provider.type "openai_compat" }}
  - model_name: "{{ $providerKey }}/*"
    litellm_params:
      model: "openai/*"
      api_base: "{{ $provider.openai_credentials.base_url }}"
      {{- $apiKey := "" }}
      {{- if and (hasKey $provider.openai_credentials "api_key") (kindIs "string" $provider.openai_credentials.api_key) }}
        {{- $apiKey = $provider.openai_credentials.api_key }}
      {{- end }}
      {{- if hasPrefix "{env:" $apiKey }}
      api_key: "os.environ/{{ trimSuffix "}" (trimPrefix "{env:" $apiKey) }}"
      {{- end }}
  {{- else if eq $provider.type "google_ai_studio" }}
  - model_name: "{{ $providerKey }}/*"
    litellm_params:
      model: "gemini/*"
      {{- if $provider.base_url }}
      api_base: "{{ $provider.base_url }}"
      {{- end }}
      {{- if hasPrefix "{env:" $provider.api_key }}
      api_key: "os.environ/{{ trimSuffix "}" (trimPrefix "{env:" $provider.api_key) }}"
      {{- end }}
  {{- else if eq $provider.type "vertex_ai" }}
  - model_name: "{{ $providerKey }}/*"
    litellm_params:
      model: "vertex_ai/*"
      {{- if hasPrefix "{env:" $provider.project_id }}
      vertex_project: "os.environ/{{ trimSuffix "}" (trimPrefix "{env:" $provider.project_id) }}"
      {{- end }}
      {{- if $provider.location }}
      vertex_location: "{{ $provider.location }}"
      {{- end }}
  {{- end }}
{{- end }}