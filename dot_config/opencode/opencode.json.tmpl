{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "external_directory": "allow",
    "skill": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "write": "allow",
    "question": "allow",
    "todowrite": "allow",
    "task": "allow",
    "lsp": "allow",
    "bash": {
      "*": "ask",
      "cd /tmp/*": "allow",
      "gh pr checks*": "allow",
      "gh pr diff*": "allow",
      "gh pr list*": "allow",
      "gh pr merge*": "allow",
      "gh pr review*": "allow",
      "gh pr view*": "allow",
      "gh repo view*": "allow",
      "git add*": "allow",
      "git checkout * -- internal/*": "allow",
      "git commit --no-verify*": "allow",
      "git config --get*": "allow",
      "git diff *": "allow",
      "git fetch origin*": "allow",
      "git log *": "allow",
      "git merge origin/main*": "allow",
      "git merge-base origin/main HEAD*": "allow",
      "git push origin HEAD:*": "allow",
      "git show *": "allow",
      "git worktree add /tmp/*": "allow",
      "git worktree remove *": "allow",
      "go build*": "allow",
      "go test*": "allow",
      "grep -rn *": "allow",
      "ls *": "allow",
      "sleep *": "allow",
      "chmod +x *": "allow"
    }
  },
  "instructions": [
    "CRUSH.md",
    "GEMINI.md",
    "docs/guidelines.md",
    ".cursor/rules/*.md",
    "AI.md",
    ".github/copilot-instructions.md"
  ],
  "mcp": {{ template "mcp/filter.tmpl" (dict "mcp" .mcp "profile" .profile "group" "global") }},
  "model": "{env:OPENCODE_MODEL}",
  "provider": {
    {{- $first := true }}
    {{- range $providerName, $provider := .providers }}
      {{- if and (eq $provider.type "openai_compat") (ne $providerName "opencode") }}
        {{- if not $first }},{{- end }}
        {{- $first = false }}
        "{{ $providerName }}": {
          "name": "{{ $provider.name }}",
          "npm": "@ai-sdk/openai-compatible",
          "options": {
            "baseURL": "{{ $provider.openai_credentials.base_url }}"
            {{- if $provider.openai_credentials.api_key }},
            "apiKey": "{{ $provider.openai_credentials.api_key }}"
            {{- end }}
          },
          "models": {
            {{- $modelFirst := true }}
            {{- range $modelKey, $model := $provider.models }}
              {{- if not $modelFirst }},{{- end }}
              {{- $modelFirst = false }}
              "{{ $model.model_name }}": {
                "name": "{{ $model.alias }}"
              }
            {{- end }}
          }
        }
      {{- end }}
    {{- end }}
  }
}
