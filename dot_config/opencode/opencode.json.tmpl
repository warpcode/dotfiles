{
  "$schema": "https://opencode.ai/config.json",
  {{ template "commands/opencode.tmpl" . }},
  "instructions": [
    "CRUSH.md",
    "GEMINI.md",
    "docs/guidelines.md",
    ".cursor/rules/*.md",
    "AI.md",
    ".github/copilot-instructions.md"
  ],
  "mcp": {{ template "mcp/filter.tmpl" (dict "mcp" .mcp "profile" .profile "group" "global") }},
  "model": "{env:OPENCODE_MODEL}",
  {{- $providers := dict -}}
  {{- range $providerName, $provider := .providers -}}
    {{- if and (eq $provider.type "openai_compat") (ne $providerName "opencode") -}}
      {{- $models := dict -}}
      {{- range $modelKey, $model := $provider.models -}}
        {{- $_ := set $models $model.model_name (dict "name" $model.alias) -}}
      {{- end -}}
      {{- $options := dict "baseURL" $provider.openai_credentials.base_url -}}
      {{- if $provider.openai_credentials.api_key -}}
        {{- $_ := set $options "apiKey" $provider.openai_credentials.api_key -}}
      {{- end -}}
      {{- $entry := dict "name" $provider.name "npm" "@ai-sdk/openai-compatible" "options" $options "models" $models -}}
      {{- $_ := set $providers $providerName $entry -}}
    {{- end -}}
  {{- end }}
  "provider": {{ $providers | toPrettyJson "  " }}
}
