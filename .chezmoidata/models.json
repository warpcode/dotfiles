                "gemini_pro_3.5_thinking_high": {
                    "model_name": "gemini-3.5-pro-thinking-high",
                    "alias": "Gemini 3.5 Pro (High)",
                    "trust_level": "trusted",
                    "options": {
                        "temperature": 0.2,
                        "thinking_budget": 2048
                    },
                    "categories": [
                        "orchestration",
                        "planning",
                        "logic",
                        "deep_reasoning",
                        "data_analysis"
                    ]
                },
                "gemini_flash_3.5_default": {
