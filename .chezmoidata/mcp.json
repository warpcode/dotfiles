{
  "mcp": {
    "documenter": {
      "context7": {
        "description": "Remote context enhancement and documentation search",
        "headers": {
          "CONTEXT7_API_KEY": "{secret:CONTEXT7_API_KEY}"
        },
        "profiles_deny": [
          "phone"
        ],
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    },
    "global": {
      "github": {
        "command": [
          "npx",
          "-y",
          "@github/github-mcp-server"
        ],
        "description": "GitHub API integration — repos, PRs, issues, search",
        "env": {
          "GITHUB_TOKEN": "{secret:GITHUB_TOKEN}"
        },
        "type": "local"
      }
    },
    "websearch": {
      "browsermcp": {
        "command": [
          "npx",
          "-y",
          "@browsermcp/mcp@latest"
        ],
        "description": "Browser control and automation via Playwright",
        "profiles_deny": [
          "work"
        ],
        "type": "local"
      },
      "chrome-devtools": {
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--autoConnect"
        ],
        "description": "Chrome DevTools protocol integration for browser interaction",
        "profiles_allow": [
          "default",
          "work"
        ],
        "type": "local"
      },
      "firecrawl": {
        "command": [
          "npx",
          "-y",
          "firecrawl-mcp"
        ],
        "env": {
          "FIRECRAWL_API_KEY": "{secret:FIRE_CRAWL_API_KEY}"
        },
        "type": "local"
      },
      "serena": {
        "command": [
          "npx",
          "-y",
          "serena-mcp"
        ],
        "profiles_allow": [
          "default"
        ],
        "type": "local"
      }
    }
  }
}